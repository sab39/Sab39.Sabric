@inherits ChangeSubscribingViewBase<PressedKeys>

<div>Keys: @pressedKeysMsg</div>

@code {
    [Parameter]
    [EditorRequired]
    public PressedKeys PressedKeys { get; set; } = default!;

    private string pressedKeysMsg => string.Join(",", PressedKeys.Keys);

    protected override PressedKeys? Source => PressedKeys;
}
