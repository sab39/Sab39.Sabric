@inherits SubscribingViewBase<GameSessionBase>

@* Genuinely changes every tick, which is what makes it the one legitimate subscriber to Ticked. *@
<div>Ticks: @Session.Ticks</div>
<div>Runtime: @Session.TotalMillis ms (@Session.FirstTickStamp to @Session.LastTickStamp)</div>
<div>Delta: @Session.Delta ms</div>
<div>
    FPS:
    @if (Session.Delta > 0)
    {
        @(1000 / Session.Delta)
    }
</div>
<div>
    Average FPS:
    @if (Session.TotalMillis > 0)
    {
        @(Session.Ticks * 1000 / Session.TotalMillis)
    }
</div>

@code {
    [Parameter]
    [EditorRequired]
    public GameSessionBase Session { get; set; } = default!;

    protected override GameSessionBase? Source => Session;

    protected override void Subscribe(GameSessionBase source) => source.Ticked += HandleTicked;
    protected override void Unsubscribe(GameSessionBase source) => source.Ticked -= HandleTicked;

    private void HandleTicked(object? sender, EventArgs args) => Invalidate();
}
